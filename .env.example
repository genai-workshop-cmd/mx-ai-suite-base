# Maximo Delivery AI Suite — environment.
# Copy to `.env` and fill in. `.env` is git-ignored and never printed by the app.
#
# Everything here is optional. With nothing set, the suite still runs:
# documents come from the deterministic templates and Maximo names are
# validated against the bundled 401-schema catalogue.

# ─── Model ────────────────────────────────────────────────────────────────
# Option A — Claude API (the blueprint default). Takes priority if set.
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-sonnet-5

# Option B — any OpenAI-compatible /chat/completions endpoint
# (NVIDIA NIM, Azure OpenAI, vLLM, LM Studio, ...). Used when no Anthropic key.
#MODEL_NAME1=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
#MODEL_URL1=https://integrate.api.nvidia.com/v1/chat/completions
#MODEL_API_KEY1=nvapi-...

# ─── Maximo Manage ────────────────────────────────────────────────────────
# Base URL includes /maximo. Generate an API key from inside Maximo:
#   fetch('/maximo/oslc/apitoken/create', {method:'POST',
#         headers:{'Content-Type':'application/json'},
#         body:JSON.stringify({expiration:-1})})
#     .then(r=>r.json()).then(d=>console.log('API KEY:', JSON.stringify(d)))
#
# Note: agents are READ-ONLY against Maximo. Only Agent 5 may write, and only
# after the final user gate.
#MAXIMO_MANAGE_URL=https://your-instance.manage.suite.maximo.com/maximo
#MAXIMO_MANAGE_APIKEY=your-api-key

# Only needed if you switch maximo.route to "oslc" in config/suite.yaml.
# base64(user:password) — or supply user:password and it is encoded for you.
#MAXAUTH=

# ─── Misc ─────────────────────────────────────────────────────────────────
#LOG_LEVEL=INFO
